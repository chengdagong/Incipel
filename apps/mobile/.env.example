# 客户端公开变量(EXPO_PUBLIC_* 会被打进客户端包)。
# 这里只放匿名 anon key 与 agent URL —— 绝不出现任何模型密钥(模型只在 agent 运行时调用)。

# Supabase 项目 URL
# 本地独立栈为 http://127.0.0.1:54521(端口段见 supabase/config.toml);
# 远端则填项目 URL https://your-project.supabase.co。
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54521

# Supabase 匿名 anon key(公开可见,受 RLS 保护;非 service key)
# 本地从 `supabase status` 的 anon key 读取。
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Agent 入口:Mastra Node agent server 的 base URL,客户端会在其后追加 /run、/logline。
# dev 脚本会把本地值自动写好(见 docs/worktree-dev.md)。
#   本地  http://127.0.0.1:<agent-port>   (pnpm dev:agent)
#   远端  https://<agent-host>
EXPO_PUBLIC_AGENT_URL=http://127.0.0.1:4111

# Google Sign-In Web client id。它是公开 client id,不是 secret。
# 本地 dev 脚本会从 supabase/config.toml 的 auth.external.google.client_id 第一项自动写入。
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# iOS client id。没有 GoogleService-Info.plist 时,Google native SDK 需要它。
# 若主工作区 apps/mobile/.env 已填写,dev 脚本会复制到当前 worktree。
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# 本地调试开关(可选):置 1 时跳过登录页、不需要 Supabase 会话,直接进创作页。
# 日常开发不要设置它:默认应在登录页点击「先随便逛逛」,走 Supabase anonymous auth。
# 生产 / 真实登录调试时务必留空或删掉。
EXPO_PUBLIC_DEV_NO_AUTH=
