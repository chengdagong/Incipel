# 客户端公开变量(EXPO_PUBLIC_* 会被打进客户端包)。
# 这里只放匿名 anon key 与 agent URL —— 绝不出现任何模型密钥(模型只在 agent 运行时调用)。

# Supabase 项目 URL
# 本地独立栈为 http://127.0.0.1:54521(端口段见 supabase/config.toml);
# 远端则填项目 URL https://your-project.supabase.co。
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54521

# Supabase 匿名 anon key(公开可见,受 RLS 保护;非 service key)
# 本地从 `supabase status` 的 anon key 读取。
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Agent 运行时(AG-UI / SSE)入口,见 ADR-0002
EXPO_PUBLIC_AGENT_URL=http://localhost:8787

# 本地开发开关(可选):置 1 时跳过登录门、不需要 Supabase 会话,直接进创作页。
# 对应 agent 的 DEV_NO_AUTH/STORE=memory(见 CLAUDE.md「只做 UI/agent 逻辑、完全不碰 Supabase」)。
# 生产 / 真实登录联调时务必留空或删掉。
EXPO_PUBLIC_DEV_NO_AUTH=
