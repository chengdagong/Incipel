{
  "expo": {
    "name": "芯 · 编剧助手",
    "slug": "incipel",
    "scheme": "incipel",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.incipel.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.incipel.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-apple-authentication"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
