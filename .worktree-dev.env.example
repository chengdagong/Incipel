# 本 worktree 的开发隔离配置模板。
#
# 一般无需手动创建:首次运行 scripts/dev-ios.sh 或 scripts/dev-android.sh 会自动生成
# .worktree-dev.env 并填好。仅当你想固定端口/模拟器名,或需要在多台 Android 设备间
# 指定目标时,才把本文件复制为 .worktree-dev.env 后手改(该文件名已被 .gitignore 忽略)。

# 本 worktree 的 Metro 端口。留空/不填时,脚本从 8081 起逐个递增,自动避开其它
# worktree 已声明及当前正在监听的端口。
EXPO_PORT=8081

# 本 worktree 专属的 iOS 模拟器名(脚本按此名创建或复用一台模拟器)。
# 留空时由分支名派生,如分支 feat/foo → incipel-feat-foo。
IOS_SIMULATOR_NAME="incipel-main"

# Android 目标 serial。留空时:仅一台 emulator 在线则自动选用,多台在线则报错要求填写。
# 多 AVD 并行示例:emulator -avd <名字> -port 5556  → serial 为 emulator-5556
ANDROID_SERIAL=""
