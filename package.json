{
  "name": "incipel",
  "private": true,
  "version": "0.0.0",
  "description": "编剧助手「织幕」(代号 Incipel)— AI 原生编剧助手 (monorepo)",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "bash scripts/dev-ios-target.test.sh && pnpm -r test",
    "test:db": "supabase db reset && supabase test db",
    "mobile:start": "pnpm --filter @incipel/mobile start",
    "dev:ios": "bash scripts/dev-ios.sh",
    "dev:android": "bash scripts/dev-android.sh",
    "dx": "node tools/incipel-dev/cli.mjs",
    "dev:agent": "node tools/incipel-dev/cli.mjs dev",
    "env:sync": "node tools/incipel-dev/cli.mjs env sync",
    "e2e:stack": "node tools/incipel-dev/cli.mjs e2e",
    "e2e:ios": "bash scripts/e2e-ios.sh",
    "db:reset": "supabase db reset"
  }
}
