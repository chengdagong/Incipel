# Anthropic(默认 provider)的 API key。仅服务端持有,客户端绝不出现任何模型密钥。
ANTHROPIC_API_KEY=

# OpenRouter provider 的 API key 与模型(MODEL_PROVIDER=openrouter 时使用)。
# 仅服务端持有。OPENROUTER_MODEL 默认 anthropic/claude-sonnet-4.5(tool-use 可靠的强模型)。
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Supabase 数据层:agent 以 service role 读写(已自行校验 JWT 与归属)。
# 本地独立栈:URL 为 http://127.0.0.1:54521(端口段见 supabase/config.toml);
# service_role key 与 JWT secret 从 `supabase status` 读取。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 校验客户端发来的 Supabase JWT 的密钥(HS256,Supabase 项目 JWT secret)。
SUPABASE_JWT_SECRET=

# ── 仅本地试用的开关(prod 绝不开)──────────────────────────────────────────
# 接真实 Supabase 时这两项都不要设(留空/删除即用真实鉴权 + SupabaseStore)。
#   DEV_NO_AUTH=1  跳过 JWT 校验,固定 dev 用户;
#   STORE=memory   用进程内存 store,免依赖 Supabase。
# DEV_NO_AUTH=
# STORE=

# 模型抽象层:选择 provider(anthropic | openrouter)。v1 只接 tool-use 可靠的 provider(见 ADR-0001)。
# 另有 fake:产出写死的确定性回合,不调任何真实模型,仅供本地 / Maestro E2E(见 scripts/e2e-ios.sh);
# prod 永不设 MODEL_PROVIDER=fake。
MODEL_PROVIDER=anthropic

# /logline 端点用的便宜小模型(一句话 logline)。
LOGLINE_MODEL=claude-3-5-haiku-latest

# 本地 Node 服务监听端口(部署到 Supabase Edge Function 时由运行时接管,见 ADR-0002)。
PORT=8787
