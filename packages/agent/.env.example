# OpenRouter provider 的 API key。仅服务端持有,客户端绝不出现任何模型密钥。
# 模型 id / temperature / reasoning 配置在 packages/agent/model.config.json。
OPENROUTER_API_KEY=

# Supabase 数据层:agent 以 service role 读写(已自行校验 JWT 与归属)。
# 本地独立栈:URL 为 http://127.0.0.1:54521(端口段见 supabase/config.toml);
# service_role key 与 JWT secret 从 `supabase status` 读取。
#
# 注意:本文件仅给「以 Node 跑 agent」(pnpm dev:agent / 专用主机)用。
# 部署成 Supabase Edge Function 时,SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_JWKS
# 由平台自动注入,不要也无需在 secrets 里设(平台禁止设 SUPABASE_ 前缀的自定义 secret);
# 校验客户端 JWT 默认走非对称签名 + JWKS(由 SUPABASE_URL 推出端点),故 Edge 上连
# SUPABASE_JWT_SECRET 都不必设。详见 supabase/functions/README.md。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 校验客户端发来的 Supabase JWT 的密钥(HS256,Supabase 项目 JWT secret)。
# 仅旧项目用对称签名时需要;新项目用非对称签名密钥(JWKS),留空即可。
SUPABASE_JWT_SECRET=

# ── 仅本地试用的开关(prod 绝不开)──────────────────────────────────────────
# 接真实 Supabase 时这两项都不要设(留空/删除即用真实鉴权 + SupabaseStore)。
#   DEV_NO_AUTH=1  跳过 JWT 校验,固定 dev 用户;
#   STORE=memory   用进程内存 store,免依赖 Supabase。
# DEV_NO_AUTH=
# STORE=

# 模型抽象层:选择 provider(openrouter | stub)。v1 只接 tool-use 可靠的 provider(见 ADR-0001)。
# 另有 stub:产出写死的确定性回合,不调任何真实模型,仅供本地 / Maestro E2E(见 scripts/e2e-ios.sh);
# prod 永不设 MODEL_PROVIDER=stub。
MODEL_PROVIDER=openrouter

# 注:agent 已无本地 Node 服务(见 ADR-0008),没有 PORT。Edge 运行时这些 key 放进
# supabase/.env(本地 serve)或 supabase secrets(远端);本文件作为 agent 环境变量的参照,
# 以及 dev 冒烟脚本(tsx,读 shell env)的取值清单。
