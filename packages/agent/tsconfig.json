{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // 内部相对 import 保留显式 .ts 扩展名;tsx / vitest / esbuild 都能解析,
    // 此项让 tsc 也放行。
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@incipel/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src"]
}
